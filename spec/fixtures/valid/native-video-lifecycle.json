        "drain",
        "begin",
        "oldFrame",
        "connected",
        "frame"
      ],
      "expect": [
        "connecting",
        "failed",
        "reject",
        "retired",
        "connecting",
        "reject",
        "connected",
        "displaying"
      ]
    },
    {
