{
  "name": "MacCompanionCloud",
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "options": {
    "createIntermediateGroups": false,
    "minimumXcodeGenVersion": "2.46.0",
    "groupSortPosition": "top",
    "deploymentTarget": {
      "iOS": "26.0",
      "macOS": "26.0"
    },
    "defaultConfig": "Release",
    "xcodeVersion": "27.1",
    "projectFormat": "xcode16_0"
  },
  "settings": {
    "base": {
      "MACOSX_DEPLOYMENT_TARGET": "26.0",
      "SWIFT_STRICT_CONCURRENCY": "complete",
      "SWIFT_VERSION": "6.0",
      "CODE_SIGN_STYLE": "Automatic",
      "ENABLE_HARDENED_RUNTIME": true
    }
  },
  "packages": {
    "Citadel": {
      "path": "../../Native/Dependencies/Citadel"
    },
    "SwiftTerm": {
      "url": "https://github.com/migueldeicaza/SwiftTerm.git",
      "revision": "5d14406844143538cd8f8851d2d8a67c1fe443e5"
    }
  },
  "targets": {
    "MacCompanionIOS": {
      "settings": {
        "base": {
          "INFOPLIST_FILE": "DirectScreenSharing-Info.plist",
          "GENERATE_INFOPLIST_FILE": false,
          "MARKETING_VERSION": "1.1",
          "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": false,
          "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
          "PRODUCT_BUNDLE_IDENTIFIER": "media.jenny.maccompanion.ios",
          "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
          "CURRENT_PROJECT_VERSION": "142",
          "SUPPORTS_MACCATALYST": false,
          "PRODUCT_NAME": "Mac Companion",
          "TARGETED_DEVICE_FAMILY": "1,2",
          "SWIFT_ACTIVE_COMPILATION_CONDITIONS": "$(inherited) MACCOMPANION_VNC_DEVELOPMENT",
          "SWIFT_OBJC_BRIDGING_HEADER": "$(SRCROOT)/../../Native/VNC/MacCompanionVNC-Bridging-Header.h",
          "CLANG_ENABLE_OBJC_ARC": "YES",
          "ENABLE_DEBUG_DYLIB": "NO",
          "CODE_SIGNING_ALLOWED": "YES",
          "HEADER_SEARCH_PATHS": [
            "$(inherited)",
            "$(SRCROOT)/.cloud/source-include",
            "$(SRCROOT)/.cloud/libvncclient/include"
          ],
          "LIBRARY_SEARCH_PATHS": [
            "$(inherited)",
            "$(SRCROOT)/.cloud/libvncclient"
          ],
          "ARCHS": "arm64",
          "ONLY_ACTIVE_ARCH": "YES",
          "OTHER_LDFLAGS": [
            "$(inherited)",
            "-lz"
          ],
          "CODE_SIGN_STYLE": "Automatic",
          "DEVELOPMENT_TEAM": "$(MACCOMPANION_DEVELOPMENT_TEAM)",
          "DEBUG_INFORMATION_FORMAT": "dwarf-with-dsym",
          "CODE_SIGN_ENTITLEMENTS": "MacCompanionIOS.entitlements",
          "SKIP_INSTALL": "NO",
          "CODE_SIGN_IDENTITY": "$(inherited)"
        },
        "configs": {
          "Debug": {
            "SWIFT_ACTIVE_COMPILATION_CONDITIONS": "$(inherited) DEBUG MACCOMPANION_VNC_DEVELOPMENT"
          },
          "Release": {
            "SWIFT_OPTIMIZATION_LEVEL": "-O",
            "SWIFT_COMPILATION_MODE": "wholemodule"
          }
        }
      },
      "sources": [
        {
          "path": "../../Apps/MacCompanionIOS",
          "excludes": [
            "Info.plist"
          ],
          "type": "syncedFolder"
        },
        {
          "buildPhase": "resources",
          "path": "../../spec/privacy-manifest/v0/targets/ios-app/PrivacyInfo.xcprivacy"
        },
        {
          "path": "../../Native/SessionActivity",
          "type": "syncedFolder"
        },
        {
          "path": "../../Native/Terminal",
          "excludes": [
            "source-lock.json",
            "Package.resolved"
          ],
          "type": "syncedFolder"
        },
        {
          "path": "../../Native/VNC",
          "excludes": [
            "source-lock.json",
            "CompanionVNCTransport.m",
            "CompanionVNCTransport.h"
          ],
          "type": "syncedFolder"
        },
        {
          "path": ".cloud/LibVNCClient-COPYING.txt",
          "buildPhase": "resources"
        }
      ],
      "type": "application",
      "platform": "iOS",
      "dependencies": [
        {
          "sdk": "Vision.framework"
        },
        {
          "sdk": "VisionKit.framework"
        },
        {
          "package": "Citadel"
        },
        {
          "package": "SwiftTerm"
        },
        {
          "framework": ".cloud/libvncclient/libvncclient.a",
          "embed": false
        },
        {
          "framework": ".cloud/dependencies/OpenSSL.framework",
          "embed": true,
          "codeSign": true
        },
        {
          "target": "MacCompanionSessionActivity",
          "embed": true,
          "codeSign": true
        }
      ]
    },
    "MacCompanionSessionActivity": {
      "type": "app-extension",
      "platform": "iOS",
      "sources": [
        {
          "path": "../../Apps/MacCompanionSessionActivity",
          "type": "syncedFolder"
        },
        {
          "path": "../../Native/SessionActivity",
          "type": "syncedFolder"
        },
        {
          "path": "../../spec/privacy-manifest/v0/targets/ios-app/PrivacyInfo.xcprivacy",
          "buildPhase": "resources"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "media.jenny.maccompanion.ios.session-status",
          "PRODUCT_NAME": "MacCompanionSessionActivity",
          "SWIFT_VERSION": "6.0",
          "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
          "TARGETED_DEVICE_FAMILY": "1,2",
          "MARKETING_VERSION": "1.1",
          "CURRENT_PROJECT_VERSION": "142",
          "CODE_SIGNING_ALLOWED": "YES",
          "APPLICATION_EXTENSION_API_ONLY": "YES",
          "SKIP_INSTALL": "YES",
          "ENABLE_DEBUG_DYLIB": "NO",
          "CODE_SIGN_STYLE": "Automatic",
          "DEVELOPMENT_TEAM": "$(MACCOMPANION_DEVELOPMENT_TEAM)",
          "DEBUG_INFORMATION_FORMAT": "dwarf-with-dsym",
          "CODE_SIGN_ENTITLEMENTS": "MacCompanionSessionActivity.entitlements",
          "CODE_SIGN_IDENTITY": "$(inherited)"
        }
      },
      "info": {
        "path": "SessionActivity-Info.plist",
        "properties": {
          "CFBundleDisplayName": "Mac Companion Session",
          "CFBundleShortVersionString": "$(MARKETING_VERSION)",
          "CFBundleVersion": "$(CURRENT_PROJECT_VERSION)",
          "NSExtension": {
            "NSExtensionPointIdentifier": "com.apple.widgetkit-extension"
          }
        }
      }
    }
  },
  "schemes": {
    "MacCompanionIOS": {
      "build": {
        "targets": {
          "MacCompanionIOS": "all"
        }
      },
      "run": {
        "config": "Debug"
      },
      "test": {
        "config": "Debug"
      },
      "profile": {
        "config": "Release"
      },
      "analyze": {
        "config": "Release"
      },
      "archive": {
        "config": "Release"
      }
    }
  },
  "configFiles": {
    "Debug": "CloudSigning.xcconfig",
    "Release": "CloudSigning.xcconfig"
  }
}
