+
+/* Optional cooperative input service, installed only after authentication. */
+static char companionReadServiceTag;
+void
+CompanionVNCSetReadService(rfbClient *client, const CompanionVNCReadService *service)
+{
+  rfbClientSetClientData(client, &companionReadServiceTag, (void *)service);
+}
+static const CompanionVNCReadService *
+CompanionVNCGetReadService(rfbClient *client)
+{
+  return (const CompanionVNCReadService *)rfbClientGetClientData(client, &companionReadServiceTag);
+}
+static rfbBool
+CompanionVNCServiceRead(rfbClient *client)
+{
+  const CompanionVNCReadService *service = CompanionVNCGetReadService(client);
+  return !service || !service->service || service->service(client);
+}
+
+static CompanionVNCReadMetrics *
+CompanionVNCGetReadMetrics(rfbClient *client)
+{
+  const CompanionVNCReadService *service = CompanionVNCGetReadService(client);
+  return service ? service->metrics : NULL;
+}
+static void
+CompanionVNCRecordSocketRead(rfbClient *client, unsigned int bytes)
+{
+  CompanionVNCReadMetrics *metrics = CompanionVNCGetReadMetrics(client);
+  if (metrics) metrics->socketBytes += bytes;
+}
+static void
+CompanionVNCRecordDelivered(rfbClient *client, unsigned int bytes)
+{
+  CompanionVNCReadMetrics *metrics = CompanionVNCGetReadMetrics(client);
+  if (metrics) metrics->deliveredBytes += bytes;
+}
+static int
+CompanionVNCWaitForRead(rfbClient *client, unsigned int usecs)
+{
+  CompanionVNCReadMetrics *metrics = CompanionVNCGetReadMetrics(client);
+  if (!metrics) return WaitForMessage(client, usecs);
+  struct timespec before, after;
+  int valid = clock_gettime(CLOCK_MONOTONIC, &before) == 0;
+  int result = WaitForMessage(client, usecs);
+  metrics->waitCalls++;
+  if (valid && clock_gettime(CLOCK_MONOTONIC, &after) == 0) {
+    double elapsed = (after.tv_sec - before.tv_sec) * 1000.0 + (after.tv_nsec - before.tv_nsec) / 1000000.0;
+    if (elapsed > 0) metrics->waitMS += elapsed;
+  }
+  return result;
+}
