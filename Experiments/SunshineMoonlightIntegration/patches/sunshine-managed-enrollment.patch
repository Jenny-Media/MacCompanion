+- (void)reportNativeSample:(CMSampleBufferRef)sampleBuffer aspectFit:(BOOL)aspectFit {
+  @synchronized(self) {
+  const char *managed = getenv("MACCOMPANION_MANAGED_ENROLLMENT");
+  const char *reportPath = getenv("MACCOMPANION_NATIVE_GEOMETRY_PATH");
+  const char *operation = getenv("MACCOMPANION_NATIVE_OPERATION");
+#ifdef MACCOMPANION_SELECTED_CAPTURE_ADAPTER
+  if (self.selectedContext.frameEpoch) {
+    CFTypeRef marker = CMGetAttachment(sampleBuffer,CFSTR("MacCompanion.NativeSurfaceEpoch"),NULL);
+    if (!marker || CFGetTypeID(marker) != CFDataGetTypeID() ||
+        ![(__bridge NSData *)marker isEqual:self.selectedContext.frameEpoch]) return;
+    operation = self.selectedContext.operationID.UTF8String;
+  }
+#endif
+  const char *expectedMode = getenv("MACCOMPANION_NATIVE_MODE");
+  CVPixelBufferRef pixels = CMSampleBufferGetImageBuffer(sampleBuffer);
+  CMVideoFormatDescriptionRef format = CMSampleBufferGetFormatDescription(sampleBuffer);
+  if (managed && strcmp(managed, "1") == 0 && reportPath && operation && expectedMode && pixels && format) {
+    size_t width = CVPixelBufferGetWidth(pixels), height = CVPixelBufferGetHeight(pixels);
+    NSString *actualMode = [NSString stringWithFormat:@"%zux%zux60", width, height];
+    // Encoder probes are not an active stream observation. Once this capture
+    // has produced the admitted dimensions, report later mismatches as well.
+    if (self.nativeGeometryObserved || [actualMode isEqualToString:[NSString stringWithUTF8String:expectedMode]]) {
+      self.nativeGeometryObserved = true;
+      self.nativeSampleSequence += 1;
+      mach_timebase_info_data_t timebase;
+      if (mach_timebase_info(&timebase) != KERN_SUCCESS || timebase.denom == 0) { return; }
+      uint64_t now = (uint64_t) (((__uint128_t) mach_absolute_time() * timebase.numer) / timebase.denom);
+      if (self.nativeReportTime == 0 || now - self.nativeReportTime >= 250000000) {
+        self.nativeReportTime = now;
+        CMVideoDimensions dimensions = CMVideoFormatDescriptionGetDimensions(format);
+        CGRect clean = CMVideoFormatDescriptionGetCleanAperture(format, true);
+        NSDictionary *report = @{@"profile": @"maccompanion.native-capture-evidence.v0.1",
+          @"operationID": [NSString stringWithUTF8String:operation], @"monotonicNanoseconds": @(now),
+          @"sampleSequence": @(self.nativeSampleSequence), @"capturePixelWidth": @(self.nativeSourceWidth),
+          @"capturePixelHeight": @(self.nativeSourceHeight), @"encodedWidth": @(width), @"encodedHeight": @(height),
+          @"formatWidth": @(dimensions.width), @"formatHeight": @(dimensions.height),
+          @"cleanX": @(clean.origin.x), @"cleanY": @(clean.origin.y), @"cleanWidth": @(clean.size.width),
+          @"cleanHeight": @(clean.size.height), @"aspectFitConfigured": @(aspectFit)};
