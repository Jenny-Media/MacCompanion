+#ifdef MACCOMPANION_NATIVE_SURFACE_EPOCH
+// Called at both upstream prefix-stripping sites. Preserve only the indexed
+// epoch marker; ordinary SEI and AUD behavior stays unchanged. Duplicate
+// markers are kept so the adapter rejects them rather than accepting one.
+static void companionSkipPrefix(PBUFFER_DESC buffer) {
+    int start = buffer->offset;
+    bool sei = isSeiNal(buffer);
+    skipToNextNal(buffer);
+    CompanionNativeSurfaceEpoch epoch;
+    bool independent = false;
+    if (sei && CompanionNativeEpochInspect((const uint8_t *)buffer->data + start,
+          (size_t)(buffer->offset - start),
+          (NegotiatedVideoFormat & VIDEO_FORMAT_MASK_H265) != 0, &epoch, &independent) == 1 && !independent) {
+        queueFragment(NULL,buffer->data,start,buffer->offset - start);
+    }
+}
+static bool companionOnlyEpochPrefixes(void) {
+    for (PLENTRY entry = nalChainHead; entry; entry = entry->next) {
+        CompanionNativeSurfaceEpoch epoch;
+        bool independent = false;
+        if (entry->bufferType != BUFFER_TYPE_PICDATA || entry->length <= 0 ||
+            CompanionNativeEpochInspect((const uint8_t *)entry->data,(size_t)entry->length,
+              (NegotiatedVideoFormat & VIDEO_FORMAT_MASK_H265) != 0,&epoch,&independent) != 1 || independent) return false;
+    }
+    return true;
+}
+#endif
