+            config.host = [Utils addressPortStringToAddress:source.host];
+            config.appVersion = source.appVersion;
+            config.serverCodecModeSupport = source.serverCodecModeSupport;
+            config.sessionURL = source.rtspSessionUrl;
+            config.streamKey = source.riKey;
+            config.streamKeyID = source.riKeyId;
+            config.width = source.width;
+            config.height = source.height;
+            config.framesPerSecond = source.frameRate;
+            config.bitrateKbps = source.bitRate;
+            NSError *error;
+            void (^eventCallback)(CompanionMoonlightVideoEvent, int) = ^(CompanionMoonlightVideoEvent event, int code) {
+                    switch (event) {
+                    case CompanionMoonlightVideoEventConnected:
+                        Log(LOG_I, @"MacCompanion embedded: connection started");
+                        [_callbacks connectionStarted]; break;
+                    case CompanionMoonlightVideoEventFirstFrame:
+                        Log(LOG_I, @"MacCompanion embedded: first decoded video frame displayed");
+                        [_callbacks videoContentShown]; break;
+                    case CompanionMoonlightVideoEventFailed:
+                        [_callbacks launchFailed:[NSString stringWithFormat:@"Embedded video failed (%d)", code]]; break;
+                    case CompanionMoonlightVideoEventDisconnected:
+                        [_callbacks connectionTerminated:code]; break;
+                    }
+                };
+            BOOL started = NO;
+            if (getenv("MACCOMPANION_REFERENCE_NORMAL_SURFACE") != NULL) {
+                MacCompanionNativeSurfaceProbe *probe = [[MacCompanionNativeSurfaceProbe alloc]
+                    initWithConfiguration:config referenceView:[renderer companionReferenceView]
+                    event:eventCallback error:&error];
+                self->_embeddedVideo = probe;
+                started = [probe startAndReturnError:&error];
+                Log(LOG_I, @"MacCompanion embedded: normal UIKit surface selected (input disabled)");
+            } else {
+                CompanionMoonlightVideo *video = [[CompanionMoonlightVideo alloc] initWithConfiguration:config
+                    view:[renderer companionReferenceView] event:eventCallback error:&error];
+                self->_embeddedVideo = video;
+                started = [video start:&error];
+            }
+            if (!self->_embeddedVideo || !started) {
+                [_callbacks launchFailed:@"Embedded video could not start"];
+            }
+            self->_embeddedConfiguration = nil;
+        });
+        return;
+    }
+#endif
